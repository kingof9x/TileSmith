# Installed packages and build output (all regenerated by npm install / npm run dist / Gradle / Xcode)
node_modules/
package-lock.json
dist/
*.exe
*.dmg
*.blockmap
*.apk
*.aab

# Mobile: the copied web page and generated assets (npm run android / ios, prepare-assets.js make them)
tilesmith-desktop/mobile/www/
tilesmith-desktop/android-aistudio/android/app/src/main/assets/
tilesmith-desktop/android-aistudio/android/.gradle/
tilesmith-desktop/android-aistudio/android/build/
tilesmith-desktop/android-aistudio/android/app/build/
tilesmith-desktop/android-aistudio/android/local.properties

# Build-time binaries that are not ours to share: ffmpeg (GPL build) and the NDI® runtime (NDI® SDK licence).
# Each build computer adds them itself (see BUILD-WINDOWS.txt / BUILD-MAC.txt). Spout and Syphon DO belong here.
tilesmith-desktop/bin/ffmpeg*
tilesmith-desktop/bin/mac/ffmpeg*
tilesmith-desktop/bin/ndi/*
!tilesmith-desktop/bin/ndi/README.txt
tilesmith-desktop/bin/mac/ndi/*
!tilesmith-desktop/bin/mac/ndi/README.txt

# Documentation tools: generated screenshots, kit builds and test output
manual-src/kit/
manual-src/shots/
manual-src/manual.html
manual-src/tests/aout/
manual-src/tests/kstub/out/
__pycache__/

# System files
.DS_Store
Thumbs.db
