# Text files are stored with LF line endings; Windows batch files keep CRLF.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf
*.sh text eol=lf
# Binary files
*.png binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.dll binary
*.node binary
*.jar binary
# Append-only notes: on a local merge keep both sides instead of stopping on a conflict
manual-src/WORKFLOW.md merge=union
manual-src/changes/*.md merge=union
